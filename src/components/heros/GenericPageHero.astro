---
const { header, text } = Astro.props;
---
<div>
    <h1>{header}</h1>
    <p>{text}</p>
</div>

<style>
    div {
        text-align: center;
        width: 60%;
        margin: auto;
    }
    div h1 {
        font-size: 4rem;
        margin-bottom: 0;
        
    }

    @media screen and (max-width: 900px) {
        div {
            margin: 6rem auto auto auto;
            width: 90%;
        }
        div h1 {
            font-size: 3rem;
        }
    }
</style>